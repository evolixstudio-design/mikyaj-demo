{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mikyaj-storefront",
  "main": "cloudflare/worker.mjs",
  "account_id": "d59d159b2a137c0dfcef8294c86b2a9c",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*",
      "/mikyaj/v1",
      "/mikyaj/v1/*",
      "/ar",
      "/ar/*",
      "/en",
      "/en/*",
      "/admin",
      "/admin/",
      "/shop.html",
      "/blog.html",
      "/brands.html",
      "/product.html",
      "/terms.html",
      "/privacy.html",
      "/delivery.html",
      "/returns.html",
      "/about.html",
      "/contact.html",
      "/sitemap-products.xml",
      "/sitemap-categories.xml",
      "/sitemap-journal.xml"
    ]
  }
}
