  "main": "index.js",
  "scripts": {
    "test": "node --test --test-isolation=none tests/commerce.test.cjs",
    "start": "node backend/server.js",
    "build": "node scripts/build-storefront.cjs",
    "test:browser": "node tests/browser-commerce.cjs",
    "preview:test": "node tests/preview-server.cjs",
    "db:migrate": "node scripts/migrate-commerce.cjs",
    "test:catalog": "node --test tests/scraper.test.cjs tests/enrichment-import.test.cjs",
    "test:review": "node tests/catalog-review-browser.cjs",
    "scrape:details": "node scripts/scrape-catalog-details.cjs",
    "test:admin": "node --test tests/admin-upgrade.test.cjs",
    "test:admin:browser": "node tests/admin-upgrade-browser.cjs",
    "preview:catalog": "node tests/preview-server.cjs --catalog --persistent",
    "test:media:browser": "node tests/catalog-media-browser.cjs",
    "test:translation": "node --test tests/translation-completion.test.cjs",
    "seo:verify": "node scripts/configure-search-console.cjs",
    "test:seo": "node --test tests/search-discovery.test.cjs",
    "test:banners": "node --test tests/banners.test.cjs"
